.seg {
  display: flex;
  background: var(--card);
  border-radius: 18rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--sub);
  border-radius: 14rpx;
}

.seg-item.on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--line);
}

.item:first-of-type { border-top: none; }

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  text-align: center;
  line-height: 64rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
  font-weight: 600;
}

.item-icon.sleep { background: var(--sleep-soft); color: var(--sleep); }
.item-icon.feed { background: var(--feed-soft); color: var(--feed); }

.item-title { font-size: 28rpx; }

.item-sub {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.item-right {
  font-size: 26rpx;
  color: var(--sub);
  font-variant-numeric: tabular-nums;
}

.chev {
  color: var(--sub);
  font-size: 32rpx;
  margin-left: 12rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 52rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(91, 141, 239, 0.4);
}
