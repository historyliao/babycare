# 复制为 server/.env 后按需修改，切勿把 .env 提交到仓库
#
# PORT / HOST：对外监听地址。放在 Caddy/Nginx 后面时保持 127.0.0.1
PORT=3000
HOST=127.0.0.1

# 数据库与备份目录（相对路径以启动时的工作目录为准）
DB_FILE=./data/babycare.db
BACKUP_DIR=./data/backups

# 必填：固定一个随机串，否则每次重启全家都要重新登录
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
TOKEN_TTL_DAYS=30

# 小程序登录（公众平台 → 开发管理 → 开发设置）
WX_APPID=
WX_SECRET=

# 网页版（PWA）登录口令；留空则关闭网页版
WEB_PASSCODE=

# 直接对外提供 HTTPS 时填写证书路径；放在 Caddy 后面留空
TLS_CERT=
TLS_KEY=

# 每日快照
BACKUP_HOUR=3
BACKUP_MINUTE=30
BACKUP_KEEP_DAYS=30

# 阿里云 OSS（留空则快照写本地磁盘）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=babycare/
